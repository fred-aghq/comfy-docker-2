# Global configuration — shared across all ComfyUI instances.
# Run the commands in the comments in your host shell (i.e. not a docker container).
UID=1000 # id -u
GID=1000 # id -g
USERNAME=person # whoami

# Shared AI models directory. All instances mount this path to /ComfyUI/models.
# Leave blank to default to ./ComfyUI/models.
MODELS_HOST_PATH=

# ─────────────────────────────────────────────────────────────────────
# DO NOT add per-instance settings here.
# They live in each instance's own file: instances/<name>/instance.env
#
# To (re)generate .env, run:
#   cat .env.dist instances/*/instance.env > .env
# ─────────────────────────────────────────────────────────────────────
