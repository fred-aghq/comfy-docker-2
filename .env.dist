# Global configuration — shared across all ComfyUI instances.
# Copy this file to .env and edit:
#   cp .env.dist .env
#
# Run the commands in the comments in your host shell (i.e. not a docker container).
UID=1000 # id -u
GID=1000 # id -g
USERNAME=person # whoami

# Shared AI models directory. All instances mount this path to /ComfyUI/models.
# Leave blank to default to ./data/models.
MODELS_HOST_PATH=

# GPU architecture(s) SageAttention is compiled for. Required — there's no GPU
# to detect during an image build. See the table in the README:
#   RTX 30xx (Ampere) = 8.6, RTX 40xx (Ada) = 8.9, RTX 50xx (Blackwell) = 12.0
# Leave blank to skip building SageAttention altogether (also remove
# --use-sage-attention from your instances' COMFY_COMMANDLINE_SWITCHES).
TORCH_CUDA_ARCH_LIST=

# Caps ninja's build parallelism for the SageAttention compile. Leave blank to
# let ninja use all cores, which is what you want on your own machine; this
# exists for memory-constrained CI runners.
SAGEATTENTION_MAX_JOBS=

# Host RAM limit per ComfyUI instance (Docker's mem_limit syntax, e.g. 24g).
# Without this, a container that runs away with RAM has no cgroup ceiling, so
# the *host's* OOM killer steps in and can pick any process on the machine —
# not necessarily the runaway one. With it, that container gets OOM-killed on
# its own and restarts (restart: unless-stopped) without touching anything
# else. If you run multiple instances at once (COMPOSE_PROFILES=default,legacy),
# this applies to each instance individually, so size it for your host's RAM
# divided by however many instances you run concurrently.
COMFYUI_MEM_LIMIT=24g

# Which instance(s) `docker compose up -d` starts. Each instance declares a
# profile matching its name in docker-compose.yml.
#   COMPOSE_PROFILES=default          → just the default instance
#   COMPOSE_PROFILES=default,legacy   → both, side by side
# A one-off run doesn't need this edited: docker compose --profile legacy up -d
COMPOSE_PROFILES=default

# ── Optional: ngrok tunnel (docker-compose.ngrok.yml) ────────────────
# Auth token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Which instance to tunnel. Must be an instance whose profile is active.
NGROK_TARGET_URL=http://comfyui-default:8188

# ─────────────────────────────────────────────────────────────────────
# Only genuinely global settings belong here.
#
# Per-instance runtime settings (e.g. COMFY_COMMANDLINE_SWITCHES) live in
#   instances/<name>/instance.env
# and are loaded into the container directly — they don't need to be in .env.
#
# Per-instance host-side settings (app path, host port) are set directly on
# the service in docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────
