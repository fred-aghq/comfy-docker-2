# Global configuration — shared across all ComfyUI instances.
# Run the commands in the comments in your host shell (i.e. not a docker container).
UID=1000 # id -u
GID=1000 # id -g
USERNAME=person # whoami

# Shared AI models directory. All instances mount this path to /ComfyUI/models.
# Leave blank to default to ./ComfyUI/models.
MODELS_HOST_PATH=

# ── Instance: default ────────────────────────────────────────────────
# Host-side settings for the "default" instance.
# Docker Compose resolves these at startup (env_file can't be used for
# volume mounts or port mappings — only .env and shell env are read).
DEFAULT_COMFY_HOST_PATH=./ComfyUI
DEFAULT_HOST_PORT=8188

# ── Instance: legacy ─────────────────────────────────────────────────
# Host-side settings for the "legacy" instance (CUDA 12.8.1 / Python 3.12.3).
LEGACY_COMFY_HOST_PATH=./ComfyUI-legacy
LEGACY_HOST_PORT=8189
