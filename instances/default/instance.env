# Configuration for the "default" ComfyUI instance.
#
# This file serves two purposes:
#   1. Host-side settings (prefixed with DEFAULT_) are used by Docker Compose
#      for volume mounts and port mappings via the top-level env_file.
#   2. Runtime settings (e.g. COMFY_COMMANDLINE_SWITCHES) are passed into the
#      running container via the service-level env_file.

# ── Host-side settings (used by Docker Compose for interpolation) ────
# These variable names must match what's referenced in docker-compose.yml.
DEFAULT_COMFY_HOST_PATH=./ComfyUI
DEFAULT_HOST_PORT=8188

# ── Container runtime settings ───────────────────────────────────────
# Command-line switches passed to ComfyUI's main.py at runtime.
COMFY_COMMANDLINE_SWITCHES=--use-sage-attention
