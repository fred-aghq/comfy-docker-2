# Runtime configuration for the "default" ComfyUI instance.
#
# These variables are passed into the running container via the service's
# env_file in docker-compose.yml. They are NOT used for Docker Compose
# interpolation, so no prefixing is needed and no merge step is involved —
# edit this file and restart the instance.
#
# Host-side settings (app path, host port) live directly on the service in
# docker-compose.yml. Settings shared by all instances live in .env.

# Command-line switches passed to ComfyUI's main.py at runtime.
#
# The image ships with the comfyui_manager package pre-installed, but the
# manager UI itself is off by default since it lets custom nodes be installed
# from the web UI. Add --enable-manager below to turn it on for this instance.
COMFY_COMMANDLINE_SWITCHES=--use-sage-attention
