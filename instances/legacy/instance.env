# Runtime configuration for the "legacy" ComfyUI instance.
# These environment variables are passed into the running container.
#
# This instance mirrors the original pre-refactor setup:
#   CUDA 12.8.1 / Python 3.12.3 / PyTorch cu128

# Command-line switches passed to ComfyUI's main.py at runtime.
COMFY_COMMANDLINE_SWITCHES=--use-sage-attention

# Note: Host-side settings (port mappings, bind-mount paths) are configured
# in docker-compose.yml and .env because Docker Compose resolves those
# before the container starts. See .env.dist for details.
